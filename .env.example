# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role — SOMENTE servidor (nunca NEXT_PUBLIC_, nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super Admin da plataforma (bootstrap). E-mails separados por vírgula.
# SOMENTE servidor — nunca NEXT_PUBLIC_. Preferir tabela platform_admins (migration 026).
# PLATFORM_ADMIN_EMAILS=admin@seu-dominio.com

# App
# Site URL no Supabase Dashboard deve ser http://localhost:3000 (dev).
# Templates Invite / Reset password (Auth → Email Templates) devem usar token_hash:
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=invite|recovery&next={{ .RedirectTo }}
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TR Control ERP

# WhatsApp comercial (DDI + DDD + número, só dígitos). Usado em "Solicitar acesso".
NEXT_PUBLIC_TR_WHATSAPP_NUMBER=5511999999999

# Resend — e-mail transacional de convite/reenvio (SOMENTE servidor; nunca NEXT_PUBLIC_).
# From deve ser um domínio/remetente verificado no painel Resend.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="TR Control ERP <onboarding@seu-dominio.com>"
